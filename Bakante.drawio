        <mxCell id="e8" value="YES (Overlap)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea580c;strokeWidth=2;fontColor=#ea580c;fontStyle=1;" edge="1" parent="1" source="d-conflict" target="n-suggest">
