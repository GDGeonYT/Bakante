<mxfile host="Electron">
  <diagram name="Bakante System Flow" id="BVJFii1IXVvvSEwWLfFU">
    <mxGraphModel dx="1420" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title-box" value="BAKANTE — ISATU Real-Time Facility &amp; Room Booking System (Track 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#172554;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1080" height="50" as="geometry" />
        </mxCell>

        <!-- SECTION 1: CORE BOOKING FLOW -->
        <mxCell id="sec1-label" value="FLOW 1: REAL-TIME BOOKING &amp; CONFLICT-PREVENTION LOGIC" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- Step 1: Start -->
        <mxCell id="n-start" value="1. User Submits Booking Request&#xa;(Room, Date, Start/End Time, Requester, Office, Attendees)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- Step 2: Validate -->
        <mxCell id="n-validate" value="2. Input Gatekeeper — validateBooking.ts [O(1)]&#xa;Check: non-empty fields, valid Room ID, 07:00-21:00,&#xa;startTime &lt; endTime, attendees &lt;= room capacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="225" width="420" height="75" as="geometry" />
        </mxCell>

        <!-- Decision 1: Valid? -->
        <mxCell id="d-valid" value="All Input Rules&#xa;Passed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="335" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- Reject Validation Error -->
        <mxCell id="n-err" value="Reject Request Immediately (HTTP 400)&#xa;Show Exact Field Error&#xa;-&gt; Prevents Typos &amp; Bad Data (0% Error Rate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="345" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- Step 3: SQLite Lock -->
        <mxCell id="n-lock" value="3. Start SQLite Transaction Lock (BEGIN IMMEDIATE)&#xa;Blocks simultaneous requests for the same slot from racing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;fontColor=#312e81;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="460" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- Step 4: Binary Search Conflict Check -->
        <mxCell id="n-bsearch" value="4. Sorted Conflict Check — checkConflict.ts [O(log n)]&#xa;Load room's sorted bookings for date; run Binary Search&#xa;Overlap Rule: startA &lt; endB AND startB &lt; endA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="555" width="420" height="75" as="geometry" />
        </mxCell>

        <!-- Decision 2: Conflict? -->
        <mxCell id="d-conflict" value="Any Time&#xa;Overlap Found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="665" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- Step 5A: Booked -->
        <mxCell id="n-save" value="5A. Save Booking &amp; Commit Lock (HTTP 201)&#xa;Schedule Updated in Real Time&#xa;-&gt; Zero Double-Bookings (0% Conflict Rate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="675" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- Step 5B: Suggest Alternatives -->
        <mxCell id="n-suggest" value="5B. Conflict Blocked (HTTP 409) + Smart Suggester&#xa;1) Nearest free time gaps on same room&#xa;2) Rank free rooms out of 100 pts (45 Fit + 35 Gear + 20 Bldg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="670" width="370" height="80" as="geometry" />
        </mxCell>

        <!-- Decision 3: Pick Suggestion? -->
        <mxCell id="d-pick" value="User Picks 1-Click&#xa;Alternative?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="790" width="190" height="85" as="geometry" />
        </mxCell>

        <!-- Done Blocked -->
        <mxCell id="n-end-block" value="End — Conflict Safely Prevented" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#334155;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="825" y="910" width="240" height="45" as="geometry" />
        </mxCell>

        <!-- Edges for Flow 1 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="n-start" target="n-validate">
