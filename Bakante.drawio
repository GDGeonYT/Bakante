        <mxCell id="e4" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontStyle=1;" edge="1" parent="1" source="d-valid" target="n-lock">
          <mxGeometry relative="1" as="geometry" />
