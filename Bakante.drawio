        <mxCell id="e10" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;fontColor=#475569;fontStyle=1;" edge="1" parent="1" source="d-pick" target="n-end-block">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="YES (Re-submit Choice)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#2563eb;fontStyle=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d-pick" target="n-start">
          <mxGeometry relative="1" as="geometry">
