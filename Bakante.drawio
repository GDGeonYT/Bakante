        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="n-bsearch" target="d-conflict">
          <mxGeometry relative="1" as="geometry" />
